{
  "name": "mc-budget",
  "version": "1.0.0",
  "private": true,
  "description": "Budget probabiliste par simulation Monte Carlo : outil web FP&A (démonstration ALFA Distribution, données synthétiques)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "templates": "node scripts/make-templates.ts",
    "reference": "python3 reference/prototype_alfa.py",
    "build:artifact": "VITE_HOST=artifact vite build --outDir dist-artifact"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.8",
    "@types/node": "^22.20.4",
    "@vitest/coverage-v8": "^5.0.3",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "lz-string": "^1.5.0",
    "xlsx": "^0.18.5"
  },
  "engines": {
    "node": ">=22.18"
  }
}
